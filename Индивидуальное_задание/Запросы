SELECT s.fio, COUNT(sm.id) AS total_deliveries
FROM supplier s
JOIN stockmovement sm ON s.id = sm.supplier_id
GROUP BY s.fio
HAVING COUNT(sm.id) > 2;
SELECT i.name, SUM(sp.quantity) AS total_quantity
FROM item i
JOIN stockposition sp ON i.id = sp.item_id
GROUP BY i.name
HAVING SUM(sp.quantity) < 20;